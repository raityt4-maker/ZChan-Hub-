            if obj:IsA("Tool") then
                table.insert(found, obj.Name)
            end
        end
    end

    if #found == 0 then
        Notify("Nenhuma Tool encontrada no cliente")
    else
        -- Mostra as primeiras 10
        local msg = "Tools: " .. table.concat(found, ", ", 1, math.min(10, #found))
        Notify(msg)
        print("=== TOOLS ENCONTRADAS ===")
        for i, n in ipairs(found) do
            print(i .. ". " .. n)
        end
    end
end)

