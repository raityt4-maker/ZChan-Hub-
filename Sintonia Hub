-- Procura uma Tool pelo nome em vários locais
local function FindToolByName(name)
    local searchLocations = {
        ReplicatedStorage,
        ReplicatedStorage:FindFirstChild("Weapons"),
        ReplicatedStorage:FindFirstChild("Tools"),
        ReplicatedStorage:FindFirstChild("Items"),
        ReplicatedStorage:FindFirstChild("Assets"),
        game:GetService("ServerStorage"), -- pode não funcionar (server)
        workspace,
        workspace:FindFirstChild("Weapons"),
    }

    -- Busca exata
    for _, loc in pairs(searchLocations) do
        if loc then
            for _, obj in pairs(loc:GetDescendants()) do
                if obj:IsA("Tool") and obj.Name:lower() == name:lower() then
                    return obj
                end
            end
        end
    end

    -- Busca parcial (contém)
    for _, loc in pairs(searchLocations) do
        if loc then
            for _, obj in pairs(loc:GetDescendants()) do
                if obj:IsA("Tool") and obj.Name:lower():find(name:lower(), 1, true) then
                    return obj
                end
            end
        end
    end

    return nil
end

-- Tenta spawnar a arma no Backpack
local function SpawnToolByName(name)
    if name == "" or name == nil then
        Notify("Digite um nome")
        return
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then
        Notify("Backpack não encontrado")
        return
    end

    local tool = FindToolByName(name)

    if tool then
        local clone = tool:Clone()
        clone.Parent = backpack
        Notify("Spawnado: " .. clone.Name)
    else
        Notify("Arma não encontrada: " .. name)
    end
end

-- Tenta disparar RemoteEvents comuns de compra/spawn
local function TryRemoteSpawn(name)
    local remoteNames = {
        "PurchaseItem", "BuyItem", "BuyWeapon", "GiveWeapon",
        "GiveTool", "SpawnTool", "SpawnWeapon", "RequestWeapon",
        "BuyTool", "PurchaseWeapon", "GetWeapon"
    }

    local fired = false

    for _, rName in pairs(remoteNames) do
        local remote = ReplicatedStorage:FindFirstChild(rName)
            or ReplicatedStorage:FindFirstChild(rName, true)

        if remote and remote:IsA("RemoteEvent") then
            pcall(function()
                remote:FireServer(name)
                remote:FireServer("Buy", name)
                remote:FireServer("Purchase", name)
                remote:FireServer(name, 1)
            end)
            fired = true
        end
    end

    if not fired then
        Notify("Nenhum RemoteEvent encontrado")
    else
        Notify("Tentativa enviada")
    end
end

